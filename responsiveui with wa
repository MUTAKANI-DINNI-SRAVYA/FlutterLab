import 'package:flutter/material.dart';

void main() {
  runApp(const MyApp());
}

class MyApp extends StatelessWidget {
  const MyApp({super.key});

  // Street lights image
  static const String streetLightImage =
      'https://images.unsplash.com/photo-1519501025264-65ba15a82390?auto=format&fit=crop&w=1200&q=80';

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      debugShowCheckedModeBanner: false,
      home: Builder(
        builder: (context) {
          double width = MediaQuery.of(context).size.width;

          return Scaffold(
            appBar: AppBar(
              title: const Text("Responsive UI"),
            ),

            drawer: Drawer(
              child: ListView(
                children: const [
                  DrawerHeader(
                    decoration: BoxDecoration(
                      color: Colors.blue,
                    ),
                    child: Text(
                      "Menu",
                      style: TextStyle(
                        color: Colors.white,
                        fontSize: 25,
                      ),
                    ),
                  ),
                  ListTile(
                    leading: Icon(Icons.home),
                    title: Text("Home"),
                  ),
                  ListTile(
                    leading: Icon(Icons.message),
                    title: Text("Messages"),
                  ),
                  ListTile(
                    leading: Icon(Icons.photo),
                    title: Text("Photos"),
                  ),
                ],
              ),
            ),

            body: Center(
              child: width < 600
                  ? Column(
                      children: [
                        Expanded(
                          child: Image.network(
                            streetLightImage,
                            width: double.infinity,
                            fit: BoxFit.cover,
                          ),
                        ),
                      ],
                    )
                  : width < 900
                      ? Column(
                          children: [
                            Expanded(
                              child: Image.network(
                                streetLightImage,
                                width: double.infinity,
                                fit: BoxFit.cover,
                              ),
                            ),
                          ],
                        )
                      : Row(
                          children: [
                            Expanded(
                              child: Image.network(
                                streetLightImage,
                                fit: BoxFit.cover,
                              ),
                            ),
                          ],
                        ),
            ),
          );
        },
      ),
    );
  }
}
